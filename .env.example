# Required for Serper-first owner lookup, DBA resolver, LinkedIn/About fallbacks.
# Prefer Serper over Apify. google.serper.dev — 1 credit per search.
SERPER_API_KEY=

# Apify is the blocked-HTML / CA hybrid fallback only. Never paid Store datasets.
APIFY_TOKEN=
# Hard cap for a process. Live probes: 2.
APIFY_MAX_USD=2

# Optional residential proxy password if a state HTML adapter needs it.
# APIFY_PROXY_PASSWORD=

# Optional Illinois Data Transparency Act bulk files (or auto-download).
# IL_DTA_DIR=

# Optional find-named-person HTTP fallback when SOS lists only an agent.
# POST {url}/lookup-one  { company_name, city, state, domain, client_tag }
# FIND_NAMED_PERSON_URL=
# FIND_NAMED_PERSON_CLIENT_TAG=business_owners

# Optional Supabase (writes are disabled in this phase; reserved for later persist).
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

PORT=8080
