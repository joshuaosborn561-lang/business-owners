# Required for Serper-first owner lookup, DBA resolver, LinkedIn/About fallbacks.
# Prefer Serper over Apify. google.serper.dev — 1 credit per search.
SERPER_API_KEY=

# Apify is the blocked-HTML / CA hybrid fallback only. Never paid Store datasets.
APIFY_TOKEN=
# Unified Apify + Serper cap (file-backed). Live probes: 2–3.
TOTAL_MAX_USD=3
# Hard cap shared across the whole batch (file-backed). Used when TOTAL_MAX_USD is unset.
APIFY_MAX_USD=2
# Per-company Apify ceiling. Default $0.02 — enough for one blocked fetch, not a crawl.
APIFY_USD_PER_COMPANY=0.02
# Shared spend ledger so multiple processes honor one global cap.
# APIFY_SPEND_FILE=
# Parallel company lookups (default 5) and optional wall-clock stop.
# LOOKUP_CONCURRENCY=5
# LOOKUP_MAX_SECONDS=

# Optional residential proxy password if a state HTML adapter needs it.
# APIFY_PROXY_PASSWORD=

# Unblocker: pay-as-you-go residential fetch API for the ~20 bot-walled registries
# (GA NC UT MO MS MT HI AK NH MA NV WA WY MI AZ IA KS IN TN VA OR SC). Charged to TOTAL_MAX_USD.
# UNBLOCKER_PROVIDER=zyte          # zyte | brightdata | scrapingbee | scraperapi
# UNBLOCKER_API_KEY=
# UNBLOCKER_ZONE=                  # brightdata only
# UNBLOCKER_USD_PER_REQUEST=0.004  # used for quotes and the ledger
# UNBLOCKER_RENDER_JS=true

# Free open-data owner sources (PA officers, FMCSA, NPPES, license/liquor/trade-name files). Default on.
# OPEN_DATA_ENABLED=true

# Optional Illinois Data Transparency Act bulk files (or auto-download).
# IL_DTA_DIR=

# Optional find-named-person HTTP fallback when SOS lists only an agent.
# POST {url}/lookup-one  { company_name, city, state, domain, client_tag }
# FIND_NAMED_PERSON_URL=
# FIND_NAMED_PERSON_CLIENT_TAG=business_owners

# Optional Supabase (writes are disabled in this phase; reserved for later persist).
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

PORT=8080

# FL Sunbiz / IL LLC / FL DBPR registry index in Supabase (schema business_owners).
# Publishable key + a service token whose sha256 is in business_owners.api_token.
BO_SUPABASE_URL=
BO_SUPABASE_KEY=
BO_REGISTRY_TOKEN=

# Table jobs (start_table_job): read a Supabase table server-side, write results to a table. See README "Table jobs".
# Apply supabase/migrations/20261028_table_jobs.sql first. Without these three the table tools answer "not configured".
# TABLE_JOBS_SUPABASE_URL=https://<project>.supabase.co
# TABLE_JOBS_SUPABASE_KEY=          # publishable/anon key of that project
# TABLE_JOBS_TOKEN=                 # random secret; sha256 stored in bo_jobs.api_token
# MCP_AUTH_TOKEN=                   # recommended: require Bearer / ?key= on /mcp
# TABLE_JOBS_MAX_USD=100            # per-job max_usd ceiling
# TABLE_JOBS_READ_SCHEMAS=scratch,client_emcor,client_salesglider,client_peterson,client_techevo,lp,public
# TABLE_JOBS_WRITE_SCHEMAS=scratch,client_emcor,client_salesglider,client_peterson,client_techevo
# TABLE_JOBS_BATCH=50
# TABLE_JOBS_AUTORESUME=true
