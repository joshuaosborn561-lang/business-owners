# Required for Serper-first owner lookup, DBA resolver, LinkedIn/About fallbacks.
# Prefer Serper over Apify. google.serper.dev — 1 credit per search.
SERPER_API_KEY=

# Apify is the blocked-HTML / CA hybrid fallback only. Never paid Store datasets.
APIFY_TOKEN=
# Unified Apify + Serper cap (file-backed). Live probes: 2–3.
TOTAL_MAX_USD=3
# Hard cap shared across the whole batch (file-backed). Used when TOTAL_MAX_USD is unset.
APIFY_MAX_USD=2
# Per-company Apify ceiling. Default $0.02 — enough for one blocked fetch, not a crawl.
APIFY_USD_PER_COMPANY=0.02
# Shared spend ledger so multiple processes honor one global cap.
# APIFY_SPEND_FILE=
# Parallel company lookups (default 5) and optional wall-clock stop.
# LOOKUP_CONCURRENCY=5
# LOOKUP_MAX_SECONDS=

# Optional residential proxy password if a state HTML adapter needs it.
# APIFY_PROXY_PASSWORD=

# Optional Illinois Data Transparency Act bulk files (or auto-download).
# IL_DTA_DIR=

# Optional find-named-person HTTP fallback when SOS lists only an agent.
# POST {url}/lookup-one  { company_name, city, state, domain, client_tag }
# FIND_NAMED_PERSON_URL=
# FIND_NAMED_PERSON_CLIENT_TAG=business_owners

# Optional Supabase (writes are disabled in this phase; reserved for later persist).
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

PORT=8080

# FL Sunbiz / IL LLC / FL DBPR registry index in Supabase (schema business_owners).
# Publishable key + a service token whose sha256 is in business_owners.api_token.
BO_SUPABASE_URL=
BO_SUPABASE_KEY=
BO_REGISTRY_TOKEN=
