    {
      "name": "search_permits",
      "method": "GET",
      "path": "/v1/permits/search",
      "description": "Search building permits by location, date, category, contractor and more.\n\nFilters combine with AND. Supply at least one narrowing filter -- a city, ZIP,\njurisdiction, date range or lat/lng radius -- for a query that returns quickly.\n\nResults are paginated and ordered newest-first on the permit's best available date\n(`date_issued`, falling back to `date_filed`). `total` is exact up to 10,000; beyond\nthat it stops counting and returns `total: 10000` with `total_capped: true`, meaning\n\"10,000 or more\". If the count cannot finish in time the response carries\n`total: null` with `total_unknown: true` -- an unknown total is reported as unknown\nand never as a number. Rows are unaffected either way; page through them normally.\n\n`category=hvac` matches HVAC and MECHANICAL together, because AC and furnace work is\nfiled under either depending on the city. Unknown parameter names are rejected with a\n400 rather than ignored, so a typo can never silently return unfiltered results.\n\nFree-tier keys are limited to a recent window; paid tiers have full history.",
      "summary": "Search Permits",
      "tags": [
        "Permits"
      ],
      "properties": {
        "zip_code": {
          "type": "string",
          "description": "5-digit ZIP code"
        },
        "city": {
          "type": "string",
          "description": "City name"
        },
        "state": {
          "type": "string",
          "description": "2-letter state code"
        },
        "jurisdiction": {
          "type": "string",
          "description": "Jurisdiction name (e.g. 'Wake County', 'Tacoma') or partial match"
        },
        "address": {
          "type": "string",
          "description": "Street address, partial + case-insensitive (e.g. '1600 Pennsylvania') \u2014 indexed, fast"
        },
        "lat": {
          "type": "number",
          "description": "Latitude for radius search"
        },
        "lng": {
          "type": "number",
          "description": "Longitude for radius search"
        },
        "radius_miles": {
          "type": "number",
          "description": "Radius in miles (used with lat/lng)",
          "default": 5.0,
          "maximum": 50
        },
        "bbox": {
          "type": "string",
          "description": "Map-viewport bounding box 'minLng,minLat,maxLng,maxLat'. Returns permits whose location falls inside the box (geocoded permits only)."
        },
        "polygon": {
          "type": "string",
          "description": "A drawn area as a GeoJSON Polygon geometry (URL-encoded), e.g. {\"type\":\"Polygon\",\"coordinates\":[[[lng,lat],...]]}. Returns permits inside the polygon (geocoded permits only)."
        },
        "category": {
          "type": "string",
          "description": "Permit category (e.g. solar, SOLAR, roofing, hvac \u2014 case insensitive)"
        },
        "status": {
          "type": "string",
          "enum": [
            "filed",
            "issued",
            "in_progress",
            "final",
            "expired",
            "cancelled",
            "revoked",
            "unknown",
            "interconnected"
          ],
          "description": "Permit status (e.g. issued, filed, final)"
        },
        "property_type": {
          "type": "string",
          "enum": [
            "residential",
            "commercial",
            "industrial",
            "mixed_use",
            "institutional",
            "unknown"
          ],
          "description": "Property type (e.g. residential, commercial)"
        },
        "tag": {
          "type": "string",
          "description": "Filter by tag"
        },
        "record_kind": {
          "type": "string",
          "description": "Record kind: 'permit' (default, building permits only), 'contractor', 'tag', 'non_building', 'admin', or 'all'",
          "default": "permit"
        },
        "filed_after": {
          "type": "string",
          "format": "date",
          "description": "Filed on or after this date"
        },
        "filed_before": {
          "type": "string",
          "format": "date",
          "description": "Filed on or before this date"
        },
        "issued_after": {
          "type": "string",
          "format": "date",
          "description": "Issued on or after this date"
        },
        "issued_before": {
          "type": "string",
          "format": "date",
          "description": "Issued on or before this date"
        },
        "date_after": {
          "type": "string",
          "format": "date",
          "description": "On or after this date, matched against whichever date a record has (issued, else filed). Use this when a source populates only one of issued/filed \u2014 e.g. issued-only feeds vs filed-only feeds."
        },
        "date_before": {
          "type": "string",
          "format": "date",
          "description": "On or before this date, matched against whichever date a record has (issued, else filed)."
        },
        "parcel": {
          "type": "string",
          "description": "Parcel number / APN / folio (formatting ignored). Returns permits on that parcel where the source publishes one."
        },
        "min_value": {
          "type": "number",
          "description": "Minimum estimated value"
        },
        "max_value": {
          "type": "number",
          "description": "Maximum estimated value"
        },
        "min_solar_kw": {
          "type": "number",
          "description": "Minimum extracted solar system size (kW DC)"
        },
        "max_solar_kw": {
          "type": "number",
          "description": "Maximum extracted solar system size (kW DC)"
        },
        "min_sqft": {
          "type": "number",
          "description": "Minimum square footage mentioned (from enrichment)"
        },
        "has_enrichment": {
          "type": "boolean",
          "description": "Only permits that have (true) or lack (false) LLM enrichment"
        },
        "scope": {
          "type": "string",
          "description": "Substring match on the enriched work scope"
        },
        "q": {
          "type": "string",
          "description": "Case-insensitive substring match across description, address, and permit number"
        },
        "contractor_name": {
          "type": "string",
          "description": "Contractor name (partial match)"
        },
        "owner_filed": {
          "type": "boolean",
          "description": "true = owner-filed permits only (no contractor on record but an owner name is present \u2014 often a DIY/homeowner lead, though for feeds that don't capture contractors the owner may be a builder or institution); false = permits that have a contractor"
        },
        "has_owner_address": {
          "type": "boolean",
          "description": "true = only permits that carry a property-owner mailing address; false = only those that do not. Coverage varies sharply by jurisdiction (we hold the county assessor roll for some and not others), so this is a targeting filter rather than a defect: it returns exactly the rows that are actionable. The address itself is visible on Business and above."
        },
        "page": {
          "type": "integer",
          "default": 1,
          "minimum": 1
        },
        "per_page": {
          "type": "integer",
          "description": "Results per page. Above your plan's maximum this is clamped, not rejected; the response echoes the per_page actually applied.",
          "default": 25,
          "minimum": 1
        },
        "keyword": {
          "type": "string",
          "description": "Alias of `q`."
        },
        "date_from": {
          "type": "string",
          "format": "date",
          "description": "Alias of `date_after`."
        },
        "date_to": {
          "type": "string",
          "format": "date",
          "description": "Alias of `date_before`."
        },
        "start_date": {
          "type": "string",
          "format": "date",
          "description": "Alias of `date_after`."
        },
        "end_date": {
          "type": "string",
          "format": "date",
          "description": "Alias of `date_before`."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "Alias of `per_page`. Clamped to your plan's maximum, not rejected."
        }
      },
      "required": [],
      "pathParams": [],
      "queryParams": [
        "zip_code",
        "city",
        "state",
        "jurisdiction",
        "address",
        "lat",
        "lng",
        "radius_miles",
        "bbox",
        "polygon",
        "category",
        "status",
        "property_type",
        "tag",
        "record_kind",
        "filed_after",
        "filed_before",
        "issued_after",
        "issued_before",
        "date_after",
        "date_before",
        "parcel",
        "min_value",
        "max_value",
        "min_solar_kw",
        "max_solar_kw",
        "min_sqft",
        "has_enrichment",
        "scope",
        "q",
        "contractor_name",
        "owner_filed",
        "has_owner_address",
        "page",
        "per_page",
        "keyword",
        "date_from",
        "date_to",
        "start_date",
        "end_date",
        "limit"
      ],
      "bodyParams": []
    },
