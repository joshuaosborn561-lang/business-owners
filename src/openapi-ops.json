    {
      "name": "sync_permits",
      "method": "GET",
      "path": "/v1/permits/sync",
      "description": "Incremental data feed (change-data-capture). Page the dataset ordered by\n(updated_at, id). Omit `cursor` for the initial full load; persist `next_cursor` and pass\nit back after each nightly ingest to receive only new + changed permits. Upsert-only\n(deletes are not emitted).",
      "summary": "Sync Permits",
      "tags": [
        "Permits"
      ],
      "properties": {
        "cursor": {
          "type": "string",
          "description": "Opaque cursor from the previous response's `next_cursor`. Omit to start the initial full sync from the beginning."
        },
        "since": {
          "type": "string",
          "description": "Alternative start point: an ISO-8601 UTC timestamp; returns permits with updated_at >= since. Ignored when `cursor` is supplied."
        },
        "limit": {
          "type": "integer",
          "description": "Max permits per page (cursor page size, up to 50,000).",
          "default": 5000,
          "minimum": 1,
          "maximum": 50000
        },
        "record_kind": {
          "type": "string",
          "description": "'permit' (default), a specific record_kind, or 'all'.",
          "default": "permit"
        },
        "state": {
          "type": "string",
          "description": "Optional 2-letter state filter to scope the feed."
        },
        "category": {
          "type": "string",
          "description": "Optional category filter (e.g. solar, roofing)."
        }
      },
      "required": [],
      "pathParams": [],
      "queryParams": [
        "cursor",
        "since",
        "limit",
        "record_kind",
        "state",
        "category"
      ],
      "bodyParams": []
    },
